# ==============================================================================
# NO ENTRY — SOC Intelligence Platform Environment Configuration
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# ── 1. PostgreSQL / Supabase / Neon Database ──────────────────────────────────
# Paste your Supabase URI (from Project Settings -> Database -> Connection string -> URI)
# e.g. postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Optional: Supabase API credentials (if utilizing Supabase Realtime client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── 2. Threat Triage & Indicator Enrichment APIs ──────────────────────────────
# VirusTotal API Key (https://www.virustotal.com — 4 free lookups/min)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AbuseIPDB API Key (https://www.abuseipdb.com — 1,000 free queries/day)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# ── 3. AI & LLM Engine ────────────────────────────────────────────────────────
# Option A: Python AI Microservice (app.py)
AI_SERVICE_URL=http://localhost:8000

# Option B: Direct OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here

# Option C: Local Ollama URL
OLLAMA_URL=http://localhost:11434

# ── 4. ChatOps & Alert Broadcasting (Webhooks) ────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/your/teams/webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/discord/webhook

# ── 5. SIEM External Ingestion (Wazuh / Snort / Suricata) ─────────────────────
# Auth key for POST /api/v1/alerts
INGEST_API_KEY=no-entry-secret-ingest-key-2026

# ── 6. Automated Periodic Email Reports (SMTP) ────────────────────────────────
DEFAULT_EMAIL=poornasujampathi@gmail.com
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-google-app-password
