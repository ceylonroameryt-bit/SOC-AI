# ==============================================================================
# NO ENTRY SOC Intelligence Platform — Environment Configuration Template
# Copy this file to .env and provide your deployment-specific credentials.
# NEVER commit real API keys, passwords, or production secrets to version control.
# ==============================================================================

# ── 1. Application Runtime (REQUIRED) ──────────────────────────────────────────
PORT=3000
NODE_ENV=production
APP_MODE=production
ENABLE_DEMO_DATA=false
ALLOWED_ORIGIN=https://soc-ai-six.vercel.app

# ── 2. PostgreSQL / Supabase Database Connection (REQUIRED for production) ─────
# The application automatically supports any of these standard environment keys:
# DATABASE_URL, POSTGRES_URL, or SUPABASE_DB_URL
DATABASE_URL=postgresql://postgres.placeholder:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL=postgresql://postgres.placeholder:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.placeholder:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-supabase-anon-key

# ── 3. Internal Automation & Administration Security (REQUIRED for mutations) ──
# Protects feed collection triggers, analyst action mutations, and webhook dispatches.
# Guest users are strictly read-only without this key.
INGEST_API_KEY=placeholder-strong-random-ingest-key-min-32-chars
NOTIFICATION_API_KEY=placeholder-strong-random-notification-key
SIGMA_AUTHOR=NO ENTRY SOC Platform (auto-generated)

# ── 4. AI / LLM Engine (OPTIONAL) ──────────────────────────────────────────────
# Enables automated executive synthesis briefings. If absent, platform uses rule-based synthesis.
OPENAI_API_KEY=sk-placeholder-openai-key
OPENAI_MODEL=gpt-4o-mini
AI_SERVICE_URL=http://127.0.0.1:8000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── 5. Threat Triage & Indicator Enrichment APIs (OPTIONAL) ───────────────────
# Real-time reputation lookups for IP, domain, hash, and CVE indicators.
VIRUSTOTAL_API_KEY=placeholder-virustotal-api-key
ABUSEIPDB_API_KEY=placeholder-abuseipdb-api-key

# ── 6. ChatOps & Alert Broadcasting Webhooks (OPTIONAL) ──────────────────────
# External notification endpoints for critical threat notifications.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/WEBHOOK
TEAMS_WEBHOOK_URL=https://placeholder.webhook.office.com/webhookb2/PLACEHOLDER
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/PLACEHOLDER/WEBHOOK

# ── 7. Email Dispatch (SMTP) (OPTIONAL) ───────────────────────────────────────
# Dedicated SMTP credentials for alert dispatches and scheduled daily sitrep reports.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@your-domain.com
SMTP_PASS=placeholder-app-password
SMTP_SECURE=false
DEFAULT_EMAIL=alerts@your-domain.com
EMAIL_USER=alerts@your-domain.com
EMAIL_PASS=placeholder-app-password
