# ==============================================================================
# NO ENTRY SOC Intelligence Platform — Environment Configuration Template
# Copy this file to .env and provide your deployment-specific credentials.
# NEVER commit real API keys, passwords, or production secrets to version control.
# ==============================================================================

# ── 1. Core Runtime & Server Environment ──────────────────────────────────────
# Required: PORT, NODE_ENV, APP_MODE, ENABLE_DEMO_DATA
PORT=3000
NODE_ENV=production
APP_MODE=production
# ENABLE_DEMO_DATA: false = strict production (honest zero states, no fake threats); true = local dev demo fallback
ENABLE_DEMO_DATA=false
# ALLOWED_ORIGIN: Trusted origin for strict CORS (wildcard * is disabled for authenticated endpoints)
ALLOWED_ORIGIN=https://soc-ai-six.vercel.app

# ── 2. Authoritative PostgreSQL Database (REQUIRED for Production) ────────────
# The primary data store for threats, feeds, health, collection runs, analyst actions, and AI briefs.
# Supabase Transaction / Session Pooler URL (recommended port 6543 with sslmode=require)
DATABASE_URL=postgresql://postgres.placeholder:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Alternative aliases supported by deployment platforms:
POSTGRES_URL=postgresql://postgres.placeholder:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.placeholder:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Supabase API credentials (Optional: used for direct client integrations)
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-supabase-anon-key

# ── 3. Feed Ingestion & Collection Pipeline Security (REQUIRED) ───────────────
# Secret token required for administrative refresh and collector ingestion:
# Header: x-api-key: [INGEST_API_KEY]
INGEST_API_KEY=placeholder-strong-random-ingest-key-min-32-chars
NOTIFICATION_API_KEY=placeholder-strong-random-notification-key
# Target number of qualified endpoints (Default: 500)
TARGET_SOURCES=500

# ── 4. AI & Executive Briefing Service (Optional) ─────────────────────────────
# OpenAI API Key for generating executive briefings and synthesized threat advisories
OPENAI_API_KEY=sk-placeholder-openai-key
OPENAI_MODEL=gpt-4o-mini
# Secondary/Self-hosted AI fallback endpoints
AI_SERVICE_URL=http://127.0.0.1:8005
OLLAMA_URL=http://localhost:11434

# ── 5. Threat Triage & Indicator Enrichment APIs (Optional) ───────────────────
# VirusTotal Public API for IP, Domain, and Hash reputation (4 req/min on free tier)
VIRUSTOTAL_API_KEY=placeholder-virustotal-api-key
# AbuseIPDB API for IP confidence score & blacklist checks (1,000 queries/day on free tier)
ABUSEIPDB_API_KEY=placeholder-abuseipdb-api-key

# ── 6. Outbound Notifications & Email Dispatch (SMTP) (Optional) ───────────────
# When unconfigured in production, notifications return HTTP 503 instead of mock success.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=placeholder-smtp-password
SMTP_SECURE=false
SMTP_FROM=alerts@your-domain.com
DEFAULT_EMAIL=alerts@your-domain.com
EMAIL_USER=alerts@your-domain.com
EMAIL_PASS=placeholder-app-password

# ── 7. ChatOps & Alert Broadcasting Webhooks (Optional) ──────────────────────
# External delivery endpoints for SOC alerts (must be valid HTTPS URLs)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/WEBHOOK
TEAMS_WEBHOOK_URL=https://placeholder.webhook.office.com/webhookb2/PLACEHOLDER
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/PLACEHOLDER/WEBHOOK
